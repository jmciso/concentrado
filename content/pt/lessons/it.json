        {"term": "Magari!", "translation": "quem me dera!", "example": "Vai in vacanza? — Magari!"},
        {"term": "Che figata!", "translation": "que fixe!", "example": "Un concerto gratis? Che figata!"},
        {"term": "Boh", "translation": "sei lá", "example": "Dov'è Luca? — Boh."},
