        {"term": "Prego", "translation": "de nada, faça favor", "example": "Grazie! — Prego."},
        {"term": "Scusi", "translation": "desculpe (formal)", "example": "Scusi, dov'è la stazione?"},
        {"term": "Arrivederci", "translation": "adeus", "example": "Arrivederci e a presto!"},
        {"term": "Piacere", "translation": "muito prazer", "example": "Piacere, sono Marco."}
