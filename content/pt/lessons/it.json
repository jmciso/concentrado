        {"term": "un caffè", "translation": "um café (expresso)", "example": "Un caffè, per favore."},
        {"term": "un cornetto", "translation": "um croissant", "example": "Prendo un cornetto alla crema."},
        {"term": "il conto", "translation": "a conta", "example": "Il conto, per favore."},
        {"term": "lo scontrino", "translation": "o talão", "example": "Prima si fa lo scontrino alla cassa."},
        {"term": "al banco", "translation": "ao balcão", "example": "Lo bevo al banco."},
        {"term": "un bicchiere d'acqua", "translation": "um copo de água", "example": "Mi dà un bicchiere d'acqua?"}
      ]
    },
    {
      "title": "Falsos amigos",
      "tip": "Pedir «burro» numa pastelaria italiana dá manteiga, não um animal.",
