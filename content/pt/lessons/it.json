        {"term": "caldo", "translation": "quente", "example": "Oggi fa molto caldo."},
        {"term": "l'aceto", "translation": "o vinagre", "example": "Olio e aceto per l'insalata."},
        {"term": "squisito", "translation": "delicioso", "example": "Il tiramisù è squisito."}
